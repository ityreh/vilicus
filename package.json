{
  "name": "vilicus",
  "version": "0.1.0",
  "description": "Self-hosted personal assistant for managing everyday challenges",
  "private": true,
  "scripts": {
    "prepare": "husky install",
    "commit": "cz commit",
    "backend:dev": "mvn -f backend/pom.xml spring-boot:run",
    "backend:test": "mvn -f backend/pom.xml test",
    "frontend:dev": "npm --prefix frontend start",
    "frontend:build": "npm --prefix frontend run build",
    "frontend:test": "npm --prefix frontend test"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.0.0",
    "@commitlint/config-conventional": "^19.0.0",
    "husky": "^8.0.0"
  },
  "commitlint": {
    "extends": [".commitlintrc.json"]
  }
}
